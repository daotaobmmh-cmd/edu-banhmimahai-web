{
  "trailingSlash": true,
  "functions": {
    "api/*.js": {
      "includeFiles": "kynangsale/**,hoinhap/**,nhuongquyen/**"
    }
  },
  "rewrites": [
    { "source": "/moxe", "destination": "/kynangsale/index.html" },
    { "source": "/kynansale", "destination": "/kynangsale/index.html" },
    { "source": "/kynansale/:match*", "destination": "/kynangsale/:match*" }
  ]
}
