{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ApprovalManifestSchema",
  "type": "object",
  "properties": {
    "approval_id": { "type": "string" },
    "target_manifest_sha256": { "type": "string" },
    "source_commit": { "type": "string" },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string" },
    "scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expires_at": { "type": ["string", "null"] }
  },
  "required": ["approval_id", "target_manifest_sha256", "approved_by", "approved_at", "scope"]
}
