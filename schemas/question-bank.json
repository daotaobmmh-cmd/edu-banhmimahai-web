{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QuestionBankSchemaV2.2",
  "type": "object",
  "properties": {
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "module": { "type": "string", "enum": ["hoinhap", "nhuongquyen"] },
          "question": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" }, "minItems": 4, "maxItems": 4 },
          "correct_answer": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "explanation": { "type": "string" },
          "source_file": { "type": "string" },
          "source_quote": { "type": "string" },
          "source_ref": { "type": "string" },
          "content_hash": { "type": "string" },
          "extraction_type": { "type": "string", "enum": ["verbatim", "inferred", "cross_section"] },
          "status": { "type": "string", "enum": ["draft", "legacy", "reviewed", "approved", "rejected"] },
          "generated_by": { "type": "string" },
          "generated_at": { "type": "string" },
          "reviewed_by": { "type": ["string", "null"] },
          "approved_by": { "type": ["string", "null"] },
          "approved_at": { "type": ["string", "null"] },
          "reviewer_notes": { "type": ["string", "null"] }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "legacy" } } },
            "then": { "required": ["id", "module", "question", "options", "correct_answer", "status"] },
            "else": { "required": ["id", "module", "question", "options", "correct_answer", "source_file", "source_quote", "source_ref", "content_hash", "extraction_type", "status", "generated_by"] }
          }
        ]
      }
    }
  },
  "required": ["questions"]
}
